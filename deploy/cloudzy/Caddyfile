# SITE_ADDRESS comes from .env via docker-compose.yml: your domain (automatic HTTPS) or ":80" (plain HTTP).
{$SITE_ADDRESS::80} {
	encode zstd gzip
	# Caddy adds X-Forwarded-For / X-Forwarded-Proto, which Django uses for the client IP (AI rate
	# limit) and to know the request was HTTPS. AI calls can take several seconds; Caddy sets no
	# upstream timeout, so gunicorn's own 120 s limit is the only one.
	reverse_proxy web:8000
}
