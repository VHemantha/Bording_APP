# Reference for deploy/cloudzy/.env. You normally don't write this by hand: ./init-env.sh asks a few
# questions and generates it (with fresh random secrets). The real .env is gitignored, chmod 600.

# --- Generated secrets (never reuse or share) ---
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# --- Address of the site. Pick ONE block. ---
# (A) With the domain (DNS "A" records for both names point at this server) -> HTTPS, automatic
#     certificates; www.placeeka.lk redirects to placeeka.lk (see Caddyfile):
#SITE_ADDRESS=placeeka.lk, www.placeeka.lk
#DJANGO_ALLOWED_HOSTS=placeeka.lk,www.placeeka.lk
#DJANGO_CSRF_TRUSTED_ORIGINS=https://placeeka.lk,https://www.placeeka.lk
#DJANGO_SECURE_COOKIES=true
# (B) IP only -> plain HTTP (smoke tests; passwords cross the internet unencrypted):
SITE_ADDRESS=:80
DJANGO_ALLOWED_HOSTS=203.0.113.10
DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.10
DJANGO_SECURE_COOKIES=false

# Public address of the site, used in links inside emails (password reset):
#SITE_URL=https://placeeka.lk

# --- Email, for "Forgot password?" links. Blank EMAIL_HOST = emails only go to the server log
#     (docker compose logs web), nothing is sent. Use your mail provider's SMTP details. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=PlaceEka <no-reply@placeeka.lk>

# --- Optional features (blank = the feature is disabled, the rest of the site works) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_CLIENT_ID=
# Same value as GOOGLE_CLIENT_ID; baked into the JavaScript, so changing it needs a rebuild (./deploy.sh).
VITE_GOOGLE_CLIENT_ID=
# Google Maps JavaScript API key for the search page's map. Blank = OpenStreetMap is shown
# instead. Baked into the JavaScript, so changing it needs a rebuild (./deploy.sh).
VITE_GOOGLE_MAPS_API_KEY=

# --- Tuning ---
# AI_THROTTLE_RATE=20/min
# GUNICORN_CMD_ARGS=--bind=0.0.0.0:8000 --workers=2 --threads=4 --timeout=120 --worker-tmp-dir=/dev/shm --access-logfile=- --error-logfile=-
