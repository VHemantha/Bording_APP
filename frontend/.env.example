# Copy to frontend/.env.local and fill in.

# Backend API base (defaults to http://127.0.0.1:8000/api)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Google Identity Services OAuth Web client ID.
# Leave blank -> the "Continue with Google" button renders disabled.
# Authorized JavaScript origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# Google Maps JavaScript API key for the search page's map.
# Leave blank -> the map falls back to OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
